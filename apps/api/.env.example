# ==============================================================================
# MEDIAN API ENVIRONMENT CONFIGURATION (PRODUCTION / STAGING / LOCAL)
# ==============================================================================

# Core Application & Database
DATABASE_URL="postgresql://user:password@host:5432/median?sslmode=require"
PORT=4000
API_PORT=4000
WEB_ORIGIN="https://medianhq.co"
WEB_ORIGINS="https://medianhq.co,https://app.medianhq.co"

# Email Delivery (Resend Integration)
RESEND_API_KEY="re_..."
EMAIL_FROM="Median <hello@medianhq.co>"
EMAIL_REPLY_TO="hello@medianhq.co"

# Cloudinary Integrations (Server-Signed Private URLs)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# OAuth 2.0 Providers (Google & LinkedIn)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="https://api.medianhq.co/api/v1/auth/google/callback"

LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"
LINKEDIN_CALLBACK_URL="https://api.medianhq.co/api/v1/auth/linkedin/callback"

# Payments (Paystack Integration)
PAYSTACK_SECRET_KEY="sk_live_..."

# Security & Session Cookie
# Leave empty for localhost; set to ".medianhq.co" on production/staging server
COOKIE_DOMAIN=""
