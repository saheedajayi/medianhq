generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  MENTEE
  MENTOR
  ADMIN
}

enum MentorStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING_PAYMENT
  // Paid (or free) and waiting for the mentor to accept within 24 hours
  PENDING_CONFIRMATION
  CONFIRMED
  COMPLETED
  CANCELLED
  DECLINED
  // The mentor didn't respond before respondBy
  EXPIRED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum WaitlistAudience {
  MENTEE
  MENTOR
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String?
  sessionVersion Int            @default(0)
  firstName      String
  lastName       String
  role           UserRole?
  emailVerifiedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  mentorProfile  MentorProfile?
  mentorSessions MentorSession[]
  mentorAvailability WeeklyAvailability[]
  menteeProfile  MenteeProfile?
  mentorBookings Booking[]      @relation("MentorBookings")
  menteeBookings Booking[]      @relation("MenteeBookings")
  reviewsGiven   Review[]       @relation("ReviewsGiven")
  feedbackGiven  MenteeFeedback[] @relation("FeedbackGiven")

  settings           UserSettings?
  conversations      ConversationUser[]
  messagesSent       Message[]
  communityPosts     CommunityPost[]
  communityComments  CommunityComment[]
  postLikes          PostLike[]
  achievements       UserAchievement[]
  questionsAsked     Question[]           @relation("QuestionsAsked")
  questionsReceived  Question[]           @relation("QuestionsReceived")
  answersGiven       Answer[]
  mentorEarnings     MentorEarning[]
  payoutRequests     PayoutRequest[]
  securityAuditLogs  SecurityAuditLog[]
  deviceSessions     DeviceSession[]
  workExperiences    WorkExperience[]
  educations         Education[]
  socialLinks        SocialLink[]

  googleId       String?        @unique
  linkedinId     String?        @unique
}

model MentorProfile {
  id                String       @id @default(cuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline          String?
  bio               String?
  motivation        String?
  avatarUrl         String?
  gender            String?
  cvUrl             String?
  industry          String
  experience        String
  company           String?
  jobTitle          String?
  location          String?
  skills            String[]     @default([])
  tools             String[]     @default([])
  certificates      String[]     @default([])
  linkedinUrl       String?
  pricePerSession   Int          @default(0)
  currency          String       @default("NGN")
  status            MentorStatus @default(DRAFT)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model MentorSession {
  id              String   @id @default(cuid())
  mentorId        String
  mentor          User     @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  title           String
  description     String
  durationMinutes Int
  price           Int      @default(0)
  currency        String   @default("NGN")
  type            String   @default("ONE_ON_ONE")
  isLive          Boolean  @default(false)
  maxCapacity     Int?
  flyerUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  bookings        Booking[]
  @@index([mentorId])
}

model WeeklyAvailability {
  id        String   @id @default(cuid())
  mentorId  String
  mentor    User     @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  @@unique([mentorId, dayOfWeek])
}

model MenteeProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender          String?
  location        String?
  bio             String?
  avatarUrl       String?
  careerStage     String?
  goals           String[]
  goalDescription String?
  currentRole     String?
  industry        String?
  timeframe       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Booking {
  id              String        @id @default(cuid())
  mentorId        String
  mentor          User          @relation("MentorBookings", fields: [mentorId], references: [id])
  menteeId        String
  mentee          User          @relation("MenteeBookings", fields: [menteeId], references: [id])
  startsAt        DateTime
  durationMinutes Int
  status          BookingStatus @default(PENDING_PAYMENT)
  notes           String?
  meetingUrl      String?
  title           String?
  // The mentor's session this was booked from; its price and duration are what's charged
  mentorSessionId String?
  mentorSession   MentorSession? @relation(fields: [mentorSessionId], references: [id], onDelete: SetNull)
  // Deadline for the mentor to accept; after it the booking expires and is refunded
  respondBy       DateTime?
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  cancelledBy     UserRole?
  cancellationReason String?
  // Set when each side requests a video room token; drives no-show detection
  mentorJoinedAt  DateTime?
  menteeJoinedAt  DateTime?
  // MENTOR, MENTEE or BOTH, for NO_SHOW bookings
  noShowParty     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  payment         Payment?
  session         Session?
  review          Review?
  feedback        MenteeFeedback?

  @@index([mentorId, startsAt])
  @@index([status, respondBy])
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount            Int
  currency          String        @default("NGN")
  status            PaymentStatus @default(PENDING)
  provider          String        @default("PAYSTACK")
  providerReference String?       @unique
  authorizationUrl  String?
  refundAmount      Int?
  // PENDING, PROCESSED or FAILED, as reported by Paystack
  refundStatus      String?
  refundReference   String?
  refundedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

// The mentor's review of a mentee after a session, with the action items they assigned
model MenteeFeedback {
  id            String   @id @default(cuid())
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId      String
  author        User     @relation("FeedbackGiven", fields: [authorId], references: [id])
  rating        Int
  comment       String?
  // [{ id, text, completed }]
  actionItems   Json     @default("[]")
  followUpNotes String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Session {
  id               String    @id @default(cuid())
  bookingId        String    @unique
  booking          Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  completedAt      DateTime?
  completedMinutes Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ReviewsGiven", fields: [authorId], references: [id])
  rating    Int
  comment   String?
  npsScore  Int?
  createdAt DateTime @default(now())
}

model WaitlistEntry {
  id                String           @id @default(cuid())
  email             String
  firstName         String
  lastName          String
  audience          WaitlistAudience
  location          String?
  expertise         String?
  currentRole       String
  company           String?
  levelOfExperience String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([email])
  @@index([audience])
  @@index([createdAt])
}

model Industry {
  id        String   @id @default(cuid())
  name      String   @unique
  roles     Role[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id         String   @id @default(cuid())
  name       String
  industryId String
  industry   Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([name, industryId])
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model VerificationToken {
  id        String    @id @default(cuid())
  email     String
  token     String
  type      TokenType
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@unique([email, type])
  @@index([token])
}

model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotifications Boolean  @default(true)
  marketingEmails    Boolean  @default(false)
  timezone           String   @default("Africa/Lagos")
  /// { [type]: { email: boolean, inApp: boolean } }; a missing type means on
  notificationPreferences Json @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Conversation {
  id           String             @id @default(cuid())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  participants ConversationUser[]
  messages     Message[]
}

model ConversationUser {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  isRead         Boolean      @default(false)
  // When the recipient's app first received it: drives the second (grey) tick
  deliveredAt    DateTime?
  createdAt      DateTime     @default(now())
}

model CommunityPost {
  id        String             @id @default(cuid())
  authorId  String
  author    User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  content   String
  category  String             @default("General")
  tags      String[]
  comments  CommunityComment[]
  likes     PostLike[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model CommunityComment {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime      @default(now())
}

model PostLike {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([postId, userId])
}

model Achievement {
  id          String            @id @default(cuid())
  title       String
  description String
  badgeUrl    String?
  points      Int               @default(10)
  users       UserAchievement[]
  createdAt   DateTime          @default(now())
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  earnedAt      DateTime    @default(now())

  @@unique([userId, achievementId])
}

model Question {
  id        String    @id @default(cuid())
  authorId  String
  author    User      @relation("QuestionsAsked", fields: [authorId], references: [id], onDelete: Cascade)
  mentorId  String
  mentor    User      @relation("QuestionsReceived", fields: [mentorId], references: [id], onDelete: Cascade)
  title     String
  content   String
  answers   Answer[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())
}

model MentorEarning {
  id        String   @id @default(cuid())
  mentorId  String
  mentor    User     @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  bookingId String?  @unique
  // amount is the mentor's net earning: grossAmount minus platformFee
  amount    Int
  grossAmount Int?
  platformFee Int?
  currency  String   @default("NGN")
  createdAt DateTime @default(now())
}

model PayoutRequest {
  id            String   @id @default(cuid())
  mentorId      String
  mentor        User     @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  amount        Int
  currency      String   @default("NGN")
  status        String   @default("PENDING")
  accountNumber String
  bankCode      String
  createdAt     DateTime @default(now())
}

model SecurityAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String?
  action    String
  ipAddress String?
  userAgent String?
  status    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([action])
  @@index([createdAt])
}

// A browser the user is signed in on, identified by a long-lived device cookie
model DeviceSession {
  id           String   @id
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?
  ipAddress    String?
  location     String?
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  @@index([userId])
}

model WorkExperience {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String
  company      String
  industry     String?
  startMonth   Int
  startYear    Int
  endMonth     Int?
  endYear      Int?
  isCurrent    Boolean  @default(false)
  contribution String?
  skills       String[] @default([])
  tools        String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model Education {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fieldOfStudy String
  school       String
  startMonth   Int
  startYear    Int
  endMonth     Int?
  endYear      Int?
  isCurrent    Boolean  @default(false)
  learnings    String?
  skills       String[] @default([])
  tools        String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// kind is LINKEDIN, X, WEBSITE or CUSTOM; only custom links have a title
model SocialLink {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String?
  url       String
  createdAt DateTime @default(now())

  @@index([userId])
}
