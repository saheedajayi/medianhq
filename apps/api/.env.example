# ==============================================================================
# MEDIAN API ENVIRONMENT CONFIGURATION (PRODUCTION / STAGING / LOCAL)
# ==============================================================================

# Core Application & Database
# The API is a long-running server, so use Supabase's session pooler (port 5432).
# The transaction pooler (6543) needs pgbouncer=true for Prisma, which makes every query about 5x slower.
DATABASE_URL="postgresql://user:password@host:5432/median?sslmode=require&connection_limit=5"
PORT=4000
API_PORT=4000
WEB_ORIGIN="https://medianhq.co"
WEB_ORIGINS="https://medianhq.co,https://app.medianhq.co"

# Email Delivery (Resend Integration)
RESEND_API_KEY="re_..."
EMAIL_FROM="Median <hello@medianhq.co>"
EMAIL_REPLY_TO="hello@medianhq.co"
# Optional: who the personal emails come from. Unset, the name goes on EMAIL_FROM's address
EMAIL_FROM_MIDE="Mide from Median <mide@medianhq.co>"
EMAIL_FROM_FOUNDER="Abdullah, Founder, Median <abdullah@medianhq.co>"
# Signs the unsubscribe links in emails (any long random string; falls back to RESEND_API_KEY)
EMAIL_LINK_SECRET="change-me"
# Optional: adds a WhatsApp button to the email footer
WHATSAPP_URL=""
# Set to true to stop the 5-day onboarding emails on this server
ONBOARDING_EMAILS_DISABLED="false"

# Cloudinary Integrations (Server-Signed Private URLs)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# OAuth 2.0 Providers (Google & LinkedIn)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="https://api.medianhq.co/api/v1/auth/google/callback"

LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"
LINKEDIN_CALLBACK_URL="https://api.medianhq.co/api/v1/auth/linkedin/callback"

# Payments (Paystack Integration)
PAYSTACK_SECRET_KEY="sk_live_..."

# Payments in other currencies (Flutterwave v3). The secret hash is the one set
# under Settings > Webhooks in the Flutterwave dashboard, with v3 webhooks on;
# point the webhook at /api/v1/payments/webhook/flutterwave
FLUTTERWAVE_SECRET_KEY="FLWSECK-..."
FLUTTERWAVE_SECRET_HASH=""
# USD to NGN rate used only if the rates provider is down when the API starts
EXCHANGE_RATE_USD_NGN=

# Backoffice: must match the web app's BACKOFFICE_ACCESS_KEY; unlocks admin and waitlist endpoints
BACKOFFICE_ACCESS_KEY="your-production-backoffice-key"

# LiveKit Realtime Video & Messaging
LIVEKIT_API_KEY="your_livekit_api_key"
LIVEKIT_API_SECRET="your_livekit_api_secret"
LIVEKIT_URL="wss://your-project.livekit.cloud"

# Session recordings: LiveKit uploads them to this S3-compatible bucket
# (Supabase Storage, Cloudflare R2, AWS S3). Recording stays off until all five are set.
# Point LiveKit's webhook at <API>/api/v1/livekit/webhook so recordings start and finish.
RECORDINGS_S3_ENDPOINT="https://your-project.supabase.co/storage/v1/s3"
RECORDINGS_S3_REGION="eu-west-1"
RECORDINGS_S3_BUCKET="session-recordings"
RECORDINGS_S3_ACCESS_KEY="your_access_key"
RECORDINGS_S3_SECRET="your_secret"
# Days a recording is kept before it is deleted (default 30)
RECORDING_RETENTION_DAYS=30

# Where Contact Us messages are sent (default hello@medianhq.co)
CONTACT_INBOX="hello@medianhq.co"

# Security & Session Cookie
# Leave empty for localhost; set to ".medianhq.co" on production/staging server
COOKIE_DOMAIN=""
