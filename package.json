{
  "name": "medianhq",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:up": "docker compose --env-file .env.local up -d postgres",
    "db:down": "docker compose --env-file .env.local down",
    "db:logs": "docker compose --env-file .env.local logs -f postgres",
    "db:generate": "set -a && . ./.env.local && set +a && npm run db:generate -w @median/database",
    "db:migrate": "set -a && . ./.env.local && set +a && npm run db:migrate -w @median/database",
    "db:migrate:deploy": "set -a && . ./.env.local && set +a && npm run db:migrate:deploy -w @median/database",
    "db:seed": "set -a && . ./.env.local && set +a && npm run db:seed -w @median/database",
    "db:studio": "set -a && . ./.env.local && set +a && npm run db:studio -w @median/database"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
